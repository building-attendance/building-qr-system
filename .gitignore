# Dependencies
node_modules/

# Build output
dist/

# Environment files
.env
.env.local
.env.production

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Claude Code: the shared project settings (settings.json) and the project's skills (skills/) are committed; everything
# else in .claude/ is personal or generated: settings.local.json, launch.json, worktrees/ (full copies of the repository,
# never to be committed), cc10x/ and the like
.claude/*
!.claude/settings.json
!.claude/skills/
# The lock file of the vendor CLI that installs skills (`npx skills`, `neon skills`). Not tracked, on purpose: it pins no
# commit (an install from it fetches the latest version), and its hashes are of the bytes on one machine (CRLF on Windows),
# which are not the bytes in git. The pin of each skill is its SOURCE.md in .claude/skills/<name>/.
skills-lock.json

.vercel
.env*.local

# Database backups (pg_dump files hold personal data and must never be committed; see docs/runbooks/restore.md)
*.dump

# Playwright (end-to-end test output)
playwright-report/
test-results/
blob-report/

# The pictures of the UI review (npm run ui-review:pictures): never committed, they are not baselines (docs/testing.md)
ui-review-pictures/

# The timing reports of a CI part: playwright.config.js and the unit job of ci.yml write them at the root when CI is set,
# CI keeps them as artifacts, and e2e/parts.js and tests/time-sequencer.js make the weights of the parts from them
playwright-timings.json
vitest-timings.json
